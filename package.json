{
  "name": "ikano-testapp-root",
  "version": "1.0.0",
  "description": "Root management for ISO 20022 Test Platform",
  "scripts": {
    "install:backend": "pip install -r backend/requirements.txt",
    "install:frontend": "npm install --prefix frontend",
    "install:root": "npm install",
    "install:all": "npm run install:root && npm run install:backend && npm run install:frontend",
    "dev:backend": "cd backend && uvicorn app.main:app --reload",
    "dev:frontend": "npm start --prefix frontend",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}